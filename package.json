		"mode-watcher": "1.1.0",
		"nodemailer": "10.1.0",
		"only-allow": "1.2.2",
		"openapi-typescript": "7.13.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"prettier": "3.9.10",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tailwint": "1.1.16",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "8.3.4",
		"zod": "4.6.6"
