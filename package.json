	"name": "homerun",
	"overrides": {
		"@better-auth/api-key": "$better-auth",
		"@better-auth/cimd": "$better-auth",
		"@better-auth/core": "$better-auth",
		"@better-auth/drizzle-adapter": "$better-auth",
		"@better-auth/kysely-adapter": "$better-auth",
		"@better-auth/mcp": "$better-auth",
		"@better-auth/memory-adapter": "$better-auth",
		"@better-auth/mongo-adapter": "$better-auth",
		"@better-auth/oauth-provider": "$better-auth",
		"@better-auth/passkey": "$better-auth",
		"@better-auth/prisma-adapter": "$better-auth",
		"@better-auth/telemetry": "$better-auth"
	},
	"packageManager": "bun@1.4.3",
	"patchedDependencies": {
		"cpu-features@0.0.10": "patches/cpu-features@0.0.10.patch",
		"@sveltejs/adapter-bun@1.0.0": "patches/@sveltejs%2Fadapter-bun@1.0.0.patch"
	},
	"private": true,
	"scripts": {
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true && prek install --allow-missing-config || true",
		"dev": "bun scripts/dev.ts",
		"build": "bun run gen && vite build",
		"start": "./build/server",
		"gen": "svelte-kit sync && bun run scripts/generate-openapi.ts && openapi-typescript ./openapi.json -o tests/integration/support/openapi-types.ts && bunx biome check --write tests/integration/support/openapi-types.ts && bun run scripts/generate-config-schema.ts && bun run scripts/generate-architecture.ts && bun run scripts/generate-iac-spec.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit --project tsconfig.scripts.json && tsc --noEmit --project src/service-worker/tsconfig.json && go vet ./cmd/... ./internal/... ./tests/unit/go/... && go tool -modfile=tools/go/go.mod golangci-lint run ./cmd/... ./internal/... ./tests/unit/go/... && go -C terraform/provider vet ./... && go -C terraform/provider tool -modfile=../../tools/go/go.mod golangci-lint run --config ../../.golangci.yml ./...",
		"lint": "markdownlint-cli2 \"**/*.md\" && bun scripts/lint-tailwind.ts && oxlint --type-aware --deny-warnings",
		"lint:ai": "agnix --strict .",
		"lint:fix": "markdownlint-cli2 --fix \"**/*.md\" && bun scripts/lint-tailwind.ts --fix && oxlint --type-aware --fix",
		"format": "prettier --log-level warn --write \"**/*.md\" && biome format --write",
		"test": "svelte-kit sync && go test ./cmd/... ./internal/... ./tests/unit/go/... && go -C terraform/provider test ./... && bun --config=bunfig.unit.toml test tests/unit --timeout 120000",
		"test:integration": "bun test tests/integration --timeout 120000",
		"test:e2e": "playwright test",
		"screenshots": "playwright test --config playwright.screenshots.config.ts",
		"db:generate": "drizzle-kit generate"
	},
	"type": "module",
	"version": "1.0.58",
	"trustedDependencies": [
		"agnix"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
