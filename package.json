		"auth": "1.7.7",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"devalue": "6.0.2",
		"dockerode": "5.0.1",
		"drizzle-kit": "0.31.11",
		"highlight.js": "11.12.0",
